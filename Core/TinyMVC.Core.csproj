<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.18.10</Version>
        
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>TinyMVC</RootNamespace>
        
        <Nullable>disable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        
        <PackageId>com.ges.tinymvc</PackageId>
        <Authors>Derek Sliman</Authors>
        
        <Description>Model View Controller initialization framework.</Description>
        <PackageTags>initialization;dependency</PackageTags>
        
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>
    
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
        <PackageReference Include="com.ges.tinyutilities" Version="1.3.18" />
        <PackageReference Include="com.ges.tinyreactive" Version="1.3.15" />
    </ItemGroup>
    
</Project>
